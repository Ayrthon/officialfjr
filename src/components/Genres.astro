---
import Icon from './Icon.astro';

const genres: {
  label: string;
  icon:
    | 'cap'
    | 'heart'
    | 'africa'
    | 'palm'
    | 'star-outline'
    | 'house'
    | 'speaker'
    | 'k-pop'
    | 'wave';
}[] = [
  { label: 'Hip-Hop',     icon: 'cap' },
  { label: 'R&B',         icon: 'heart' },
  { label: 'Afrobeats',   icon: 'africa' },
  { label: 'Latin',       icon: 'palm' },
  { label: 'Pop',         icon: 'star-outline' },
  { label: 'House',       icon: 'house' },
  { label: 'Dancehall',   icon: 'speaker' },
  { label: 'K-Pop',       icon: 'k-pop' },
  { label: 'Open Format', icon: 'wave' },
];
---

<section id="genres" class="genres section">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Genres</span>
      <h2 class="section-title">What FJR plays.</h2>
      <p class="section-lead">
        A truly open format — from hip-hop and Afrobeats to house and K-Pop.
        The set moves with the crowd.
      </p>
    </div>

    <ul class="genres__grid reveal">
      {genres.map((g) => (
        <li class="genre-card">
          <span class="genre-card__icon">
            <Icon name={g.icon} size={28} />
          </span>
          <span class="genre-card__label">{g.label}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .genres__grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }

  @media (min-width: 640px) {
    .genres__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
    }
  }

  .genre-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    padding: 2rem 1rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    transition: border-color 0.25s var(--ease-out-expo),
      background 0.25s var(--ease-out-expo),
      transform 0.25s var(--ease-out-expo);
    text-align: center;
  }

  .genre-card:hover {
    border-color: var(--accent);
    background: var(--bg-card-hover);
    transform: translateY(-2px);
  }

  .genre-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--accent-dim);
    color: var(--accent);
  }

  .genre-card__label {
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg);
  }
</style>
