---
import Icon from './Icon.astro';
---

<section id="home" class="hero">
  <div class="hero__bg" aria-hidden="true">
    <div class="hero__bg-placeholder">
      <span class="placeholder__label">
        <Icon name="image" size={12} class="placeholder__icon" />
        Hero Photo — replace with high-res performance shot
      </span>
    </div>
    <div class="hero__scrim"></div>
  </div>

  <div class="container hero__inner">
    <div class="hero__content reveal">
      <h1 class="hero__title">FJR</h1>
      <p class="hero__subtitle">Open Format DJ &amp; MC</p>
      <p class="hero__tagline">
        Creating unforgettable<br />dancefloors worldwide.
      </p>
      <div class="hero__ctas">
        <a href="#contact" class="btn btn--primary">
          Book Now
          <Icon name="arrow-right" size={16} class="btn__icon" />
        </a>
        <a href="#presskit" class="btn btn--outline">
          <Icon name="download" size={16} class="btn__icon" />
          Download Presskit
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100dvh;
    padding-top: var(--header-h);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__bg-placeholder {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 65% 35%, rgba(225, 29, 44, 0.35), transparent 55%),
      radial-gradient(circle at 20% 70%, rgba(225, 29, 44, 0.18), transparent 60%),
      linear-gradient(135deg, #1a0708 0%, #050505 100%);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: calc(var(--header-h) + 1rem);
    color: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .hero__bg-placeholder::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
    background-size: 48px 48px;
    pointer-events: none;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(10, 10, 10, 0.4) 0%,
      rgba(10, 10, 10, 0.75) 60%,
      rgba(10, 10, 10, 0.95) 100%
    );
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    padding-block: 3rem 5rem;
    width: 100%;
  }

  @media (min-width: 1024px) {
    .hero__inner {
      padding-block: 4rem 6rem;
    }
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 720px;
  }

  .hero__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(5rem, 22vw, 15rem);
    line-height: 0.85;
    letter-spacing: -0.05em;
    color: var(--fg);
  }

  .hero__subtitle {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2.8vw, 1.5rem);
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--fg);
  }

  .hero__tagline {
    font-family: var(--font-display);
    font-size: clamp(0.95rem, 2vw, 1.15rem);
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--fg-muted);
    margin-top: 0.5rem;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }
</style>
