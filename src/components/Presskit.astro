---
import Icon from './Icon.astro';
---

<section id="presskit" class="presskit section">
  <div class="container">
    <div class="presskit__card reveal">
      <div class="presskit__copy">
        <span class="eyebrow">Presskit</span>
        <h2 class="presskit__title">
          Full bio, hi-res photos<br />and technical rider.
        </h2>
        <p class="presskit__lead">
          Everything promoters, agencies and event planners need — packaged
          in a single download.
        </p>
      </div>
      <div class="presskit__actions">
        <a href="/presskit.pdf" class="btn btn--primary" download>
          <Icon name="download" size={16} class="btn__icon" />
          Download Presskit
        </a>
        <a href="mailto:bookings@officialfjr.com?subject=Presskit%20request" class="btn btn--outline">
          <Icon name="mail" size={16} class="btn__icon" />
          Request via Email
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .presskit__card {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: clamp(1.75rem, 5vw, 3rem);
    background: linear-gradient(
      135deg,
      rgba(225, 29, 44, 0.08) 0%,
      var(--bg-card) 60%
    );
    border: 1px solid var(--border);
    border-radius: 16px;
    position: relative;
    overflow: hidden;
  }

  .presskit__card::before {
    content: '';
    position: absolute;
    top: -40%;
    right: -20%;
    width: 60%;
    height: 180%;
    background: radial-gradient(circle, var(--accent-dim) 0%, transparent 60%);
    pointer-events: none;
  }

  @media (min-width: 900px) {
    .presskit__card {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 3rem;
    }
  }

  .presskit__copy {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    position: relative;
    z-index: 1;
  }

  .presskit__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--fg);
  }

  .presskit__lead {
    color: var(--fg-muted);
    font-size: 1rem;
    line-height: 1.6;
    max-width: 44ch;
  }

  .presskit__actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    position: relative;
    z-index: 1;
    flex-shrink: 0;
  }

  @media (min-width: 480px) {
    .presskit__actions {
      flex-direction: row;
      flex-wrap: wrap;
    }
  }
</style>
