---
// Client + venue list — from mockup + FJR's public bio (Jimmy Woo, WASTID,
// the various Asian-party residencies). Add or trim freely.
const clients = [
  'ADE',
  'Exchange Asia',
  'Samsung',
  'Loungefest',
  'Bar Twenty Two',
  'Jimmy Woo',
  'WASTID!',
  'Asian Escape',
  'Feel 100%',
  'I Love Asian',
  'Asianwhite',
  'Asian Party',
  'Jumpa',
  'Asian Lovers',
];
---

<section class="trusted section--tight" aria-label="Trusted by">
  <div class="container trusted__head">
    <span class="trusted__label">Trusted By</span>
  </div>

  <div class="trusted__marquee">
    <div class="trusted__track">
      {/* First copy — read by screen readers. */}
      {clients.map((name) => (
        <span class="trusted__item">
          <span class="trusted__name">{name}</span>
          <span class="trusted__sep" aria-hidden="true"></span>
        </span>
      ))}
      {/* Second copy — visual duplicate so the CSS translate loop is seamless.
          Hidden from AT + hidden entirely when the user prefers reduced motion. */}
      {clients.map((name) => (
        <span class="trusted__item trusted__item--dup" aria-hidden="true">
          <span class="trusted__name">{name}</span>
          <span class="trusted__sep" aria-hidden="true"></span>
        </span>
      ))}
    </div>
  </div>
</section>

<style>
  .trusted {
    border-block: 1px solid var(--border);
    background: #080808;
    overflow: hidden;
  }

  .trusted__head {
    display: flex;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .trusted__label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--fg-dim);
  }

  .trusted__marquee {
    position: relative;
    overflow: hidden;
    mask-image: linear-gradient(
      to right,
      transparent 0,
      #000 6%,
      #000 94%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0,
      #000 6%,
      #000 94%,
      transparent 100%
    );
  }

  .trusted__track {
    display: flex;
    align-items: center;
    width: max-content;
    animation: trusted-scroll 42s linear infinite;
  }

  @media (hover: hover) {
    .trusted__marquee:hover .trusted__track {
      animation-play-state: paused;
    }
  }

  .trusted__item {
    display: inline-flex;
    align-items: center;
    gap: 2.5rem;
    padding-inline: 2.5rem 0;
    flex-shrink: 0;
  }

  .trusted__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.15rem, 3vw, 1.75rem);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--fg-muted);
    white-space: nowrap;
    transition: color 0.2s var(--ease-out-expo);
  }

  .trusted__item:hover .trusted__name {
    color: var(--fg);
  }

  .trusted__sep {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent-glow);
    flex-shrink: 0;
  }

  @keyframes trusted-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  /* --- Reduced motion ---------------------------------------------------- */
  /* Don't animate. Show a single wrapped row of the first copy only,       */
  /* centered like a static logo strip. Duplicates are removed entirely.    */
  @media (prefers-reduced-motion: reduce) {
    .trusted__marquee {
      /* No fade mask needed when there's nothing scrolling off-screen. */
      mask-image: none;
      -webkit-mask-image: none;
    }
    .trusted__track {
      animation: none;
      flex-wrap: wrap;
      justify-content: center;
      width: 100%;
      max-width: var(--container-max);
      margin-inline: auto;
      padding-inline: 1.25rem;
      row-gap: 1rem;
    }
    .trusted__item {
      padding-inline: 0;
      gap: 1.25rem;
    }
    .trusted__item--dup {
      display: none;
    }
    .trusted__name {
      font-size: clamp(0.95rem, 2.2vw, 1.15rem);
    }
  }
</style>
