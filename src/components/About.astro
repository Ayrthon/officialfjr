---
import Icon from './Icon.astro';
import Placeholder from './Placeholder.astro';
---

<section id="about" class="about section">
  <div class="container about__inner">
    <div class="about__copy reveal">
      <span class="eyebrow">About FJR</span>
      <h2 class="section-title">
        More than music.<br />
        <span class="about__title-accent">It's an experience.</span>
      </h2>

      <div class="about__body">
        <p>
          FJR is an Open Format DJ &amp; MC known for high-energy performances,
          seamless transitions and unforgettable crowd interaction.
        </p>
        <p>
          From festivals and clubs to corporate events and private celebrations,
          every performance is tailored to the audience.
        </p>
        <p class="about__meta">
          <strong>Based in The Netherlands.</strong><br />
          Available Worldwide.
        </p>
      </div>

      <a href="#experience" class="btn btn--outline about__cta">
        Read More
        <Icon name="arrow-right" size={16} class="btn__icon" />
      </a>
    </div>

    <div class="about__media reveal">
      <Placeholder aspect="4/3" label="Photo — DJ at the deck" />
    </div>
  </div>
</section>

<style>
  .about__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .about__inner {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
  }

  .about__copy {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .about__title-accent {
    color: var(--fg);
  }

  .about__body {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    color: var(--fg-muted);
    font-size: 1rem;
    line-height: 1.7;
    max-width: 52ch;
  }

  .about__body strong {
    color: var(--fg);
    font-weight: 600;
  }

  .about__meta {
    margin-top: 0.25rem;
  }

  .about__cta {
    align-self: flex-start;
    margin-top: 0.75rem;
  }
</style>
